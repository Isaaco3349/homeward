# Beneficiary Moove Receive API key (link settles to key owner's default wallet).
# Create at https://www.moove.xyz/dashboard/api-keys — Moove Receive Agent scopes.
MOOVE_API_KEY=

# Shown in UI copy; must match the handle on the API key account.
BENEFICIARY_HANDLE=mum

# Webhook signing secret from https://www.moove.xyz/business/manage/webhooks (whsec_…)
MOOVE_WEBHOOK_SECRET=

# Set to "true" to skip Moove HTTP and return mock checkout URLs (UI-only dev).
MOOVE_MOCK=false

# Protect POST /api/cron/due-links (required in production).
CRON_SECRET=

# Optional: override Moove API base (default https://api.moove.xyz)
# MOOVE_API_BASE_URL=https://api.moove.xyz
